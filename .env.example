# CloudExam Environment Configuration

PROJECT_NAME="CloudExam - Cloud-Based Smart Examination System"
SECRET_KEY="cloudexam_super_secure_enterprise_grade_secret_key_2026_xyz"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL for production/docker, SQLite for lightweight local development)
DATABASE_URL="sqlite:///./cloudexam.db"
# DATABASE_URL="postgresql://cloudexam_user:cloudexam_password_2026@localhost:5432/cloudexam"

# Redis Cache and Asynchronous Queues
